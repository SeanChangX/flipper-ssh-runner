# Copy to local.env (git-ignored) and fill in. Never commit local.env.
SSH_TARGET_HOST=192.0.2.10
SSH_TARGET_PORT=22
SSH_TARGET_USER=
SSH_TARGET_PASSWORD=
# lan or wifi: the transport the m4 walk sets on the saved host (default wifi)
SSH_TARGET_TRANSPORT=wifi
# hwkeys walk: the test sshd's container on this machine, and the target user's
# authorized_keys inside it (default: the linuxserver/openssh-server layout)
SSH_TARGET_CONTAINER=
SSH_TARGET_AUTHORIZED_KEYS=/config/.ssh/authorized_keys
