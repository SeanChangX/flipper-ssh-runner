# SSH Runner on the Waveshare ESP32-S3-ETH (ESP32-S3R8: 8 MB octal PSRAM, 16 MB flash), the default
# board. The SSH Runner add-on (ESP32-S3-WROOM-1-N16R8, the same memory) adds sdkconfig.addon.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (octal on the S3R8): libssh buffers, mbedTLS and the 64 KB script buffer
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Logs and the bring-up console on the native USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ethernet: W5500 over SPI, MACRAW mode with lwIP
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# lwIP: SSH sockets are bound to the chosen interface's address
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_IPV6=y

# CPU at 240 MHz, the S3's maximum (the IDF default is 160): SSH handshakes, RSA above all,
# are CPU-bound. A fixed clock, no dynamic frequency scaling: the Flipper UART and the W5500
# SPI keep their timing.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compiler: -O2 (performance), as release firmware is built; the IDF default is -Og, a debug
# setting. SSH handshakes are crypto-bound and the app has room (about 1.3 of 3 MB). Assertions
# stay on (the IDF default).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Tasks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
